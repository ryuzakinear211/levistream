{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filmanesia-clone",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "vars": {
    "TELEGRAM_BOT_TOKEN": "6673058749:AAH0X2vdpEgWNxeDhsZJy77_pXIG-_YCpRU"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "cd006e0fda6943d58b2f3a80ddfcb913"
    }
  ]
}
