{
  "name": "filmanesia-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-static-registry.js && next build",
    "start": "next start",
    "lint": "next lint",
    "tina:dev": "tinacms dev -c \"next dev\"",
    "tina:build": "tinacms build",
    "build:worker": "node scripts/generate-static-registry.js && opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "node scripts/generate-static-registry.js && opennextjs-cloudflare deploy",
    "postinstall": "node scripts/patch-opennext.js && node scripts/generate-static-registry.js"
  },
  "dependencies": {
    "autoprefixer": "^10.0.1",
    "gray-matter": "^4.0.3",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.400.0",
    "marked": "^18.0.10",
    "matroska-subtitles": "^3.3.2",
    "mongodb": "^6.21.0",
    "next": "^14.2.5",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0",
    "postcss": "^8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swiper": "^14.1.0",
    "tailwindcss": "^3.4.1",
    "tinacms": "^2.2.8",
    "typescript": "^5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.4.0",
    "@tinacms/cli": "^1.6.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.28.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
